# Copy to .env.local and fill in your own values. Never commit .env.local.
# Supabase (Singapore region) — see DEPLOY.md + supabase/schema.sql.
# NOT required to run the current app: the code does not read these
# yet; they are ready for the next step (auth + server-side tokens).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Gemini only (2026-10-30): Google AI Studio key, server-only.
# The customer never sees this key — they spend ThuKha tokens instead.
GEMINI_API_KEY=
# Legacy fallback: an older .env.local may already hold the Gemini key here.
AI_API_KEY=
AI_BACKGROUND_MODEL=gemini-2.5-flash-image
AI_TEXT_MODEL=
AI_DAILY_LIMIT=20
# Image provider: cloudflare = free Cloudflare Workers AI (FLUX.1
# schnell, text-to-image only — reference images are NOT supported),
# gemini = Gemini only (paid, image limit 0 on the free tier), unset =
# auto (Cloudflare if its env is present, otherwise Gemini). No silent
# fallback from Cloudflare to Gemini, so a free request never becomes
# a paid charge.
IMAGE_PROVIDER=
# Cloudflare Workers AI (free, server-only): Account ID from the
# Cloudflare dashboard, API token with Workers AI:Read scope
# (My Profile → API Tokens → Create Token, template "Workers AI").
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
