import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

/* Own in-app notifications (header bell).
   GET: newest first (latest 50) + unread count.
   PATCH: { id } marks one notification read, { all: true } marks
   all of mine read. A user can only touch their own rows. */
export async function GET(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ကြည့်လို့ရမယ်။" }, { status: 401 });
  }
  const { data, error } = await service
    .from("notifications")
    .select("id, type, detail, link, is_read, created_at")
    .eq("owner_id", user.id)
    .order("created_at", { ascending: false })
    .limit(50);
  if (error) return NextResponse.json({ error: "Notification ဖတ်လို့ မရပါ။" }, { status: 502 });
  const unread = (data ?? []).filter((n) => !n.is_read).length;
  return NextResponse.json({ notifications: data ?? [], unread });
}

export async function PATCH(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ လုပ်လို့ရမယ်။" }, { status: 401 });
  }
  const body = (await request.json().catch(() => ({}))) as { id?: string; all?: boolean };
  if (body.all === true) {
    const { error } = await service
      .from("notifications")
      .update({ is_read: true })
      .eq("owner_id", user.id)
      .eq("is_read", false);
    if (error) return NextResponse.json({ error: "ဖတ်ပြီးလို့ မှတ်၍ မရပါ။" }, { status: 502 });
    return NextResponse.json({ ok: true });
  }
  const id = (body.id ?? "").trim();
  if (!id) return NextResponse.json({ error: "Notification id မရှိပါ။" }, { status: 400 });
  const { error } = await service
    .from("notifications")
    .update({ is_read: true })
    .eq("id", id)
    .eq("owner_id", user.id);
  if (error) return NextResponse.json({ error: "ဖတ်ပြီးလို့ မှတ်၍ မရပါ။" }, { status: 502 });
  return NextResponse.json({ ok: true });
}
</file>

<file path="src/app/api/qa-check/route.ts">
import { NextResponse } from "next/server";

/* Dev 1 QA contract (DEV1-DETAILED-GUIDE.md §7).
   Warnings only — QA never blocks export. */

function numbers(text: string): string[] {
  return text.match(/[\d,]+/g) ?? [];
}

export async function POST(request: Request) {
  try {
    const body = (await request.json()) as {
      headline?: string;
      caption?: string;
      price?: string;
    };
    const headline = body.headline ?? "";
    const caption = body.caption ?? "";
    const price = body.price ?? "";
    const warnings: { code: string; message: string }[] = [];

    if (price) {
      const priceNums = numbers(price);
      const inText = numbers(`${headline} ${caption}`);
      if (priceNums.length > 0 && !priceNums.some((n) => inText.includes(n))) {
        warnings.push({
          code: "price_mismatch",
          message: "ဈေးနှုန်း field နဲ့ headline/caption ထဲက ဈေး မတူပါ — ပြန်စစ်ပါ။",
        });
      }
    }
    if (!headline.trim()) {
      warnings.push({
        code: "empty_headline",
        message: "Headline မရှိသေးပါ။",
      });
    }

    return NextResponse.json({ warnings, passed: warnings.length === 0 });
  } catch {
    return NextResponse.json(
      { error: "QA စစ်လို့ မရသေးပါ။" },
      { status: 500 },
    );
  }
}
</file>

<file path="src/app/api/tokens/history/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

/* Own token history: generation spending + admin refills, newest
   first. No new table — generations already log every successful
   image cost, and admin refills already log usage_events with
   event "admin_token_refill". The initial 100-token grant is NOT
   logged anywhere, so it deliberately does not appear here (the
   UI says so); history therefore does not sum to the balance. */
export async function GET(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ကြည့်လို့ရမယ်။" }, { status: 401 });
  }
  const [{ data: gens }, { data: refills }] = await Promise.all([
    service.from("generations").select("prompt, format, cost_tokens, created_at").eq("owner_id", user.id).order("created_at", { ascending: false }).limit(100),
    service.from("usage_events").select("cost_tokens, created_at").eq("owner_id", user.id).eq("event", "admin_token_refill").order("created_at", { ascending: false }).limit(100),
  ]);
  type Ev = { type: string; amount: number; prompt?: string | null; format?: string | null; created_at?: string };
  const events: Ev[] = [
    ...(gens ?? []).map((g) => ({ type: "spent" as const, amount: -(g.cost_tokens ?? 0), prompt: g.prompt, format: g.format, created_at: g.created_at })),
    ...(refills ?? []).map((r) => ({ type: "refill" as const, amount: r.cost_tokens ?? 0, created_at: r.created_at })),
  ].sort((a, b) => String(b.created_at ?? "").localeCompare(String(a.created_at ?? ""))).slice(0, 100);
  return NextResponse.json({ events });
}
</file>

