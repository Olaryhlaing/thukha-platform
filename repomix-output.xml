<file path="src/app/api/admin/support/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";
import { notifyUser } from "@/lib/notify";

/* Admin support inbox: every customer's ticket, newest first,
   with the owner's display name. PATCH answers a ticket: set
   admin_reply (up to 2000 chars) and/or status. Replying sets
   the ticket to in_progress unless the admin marks it resolved.
   Both actions are audit-logged (support_reply / support_status),
   target = the ticket id. */
const STATUSES = ["open", "in_progress", "resolved"] as const;

async function requireAdmin(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) return { error: NextResponse.json({ error: "Login လုပ်ပြီးမှ ကြည့်လို့ရမယ်။" }, { status: 401 }) };
  const { data: profile } = await service.from("profiles").select("role").eq("id", user.id).single();
  if (profile?.role !== "admin") return { error: NextResponse.json({ error: "Admin မဟုတ်လို့ ကြည့်လို့ မရပါ။" }, { status: 403 }) };
  return { user, service };
}

export async function GET(request: Request) {
  const auth = await requireAdmin(request);
  if ("error" in auth) return auth.error;
  const { service } = auth;
  const { data, error } = await service
    .from("support_tickets")
    .select("id, owner_id, category, subject, message, status, admin_reply, created_at, updated_at")
    .order("created_at", { ascending: false })
    .limit(100);
  if (error) return NextResponse.json({ error: "Ticket ဖတ်လို့ မရပါ။" }, { status: 502 });
  const ids = [...new Set((data ?? []).map((t) => t.owner_id))];
  const { data: users } = ids.length
    ? await service.from("profiles").select("id, display_name").in("id", ids)
    : { data: [] as { id: string; display_name: string | null }[] };
  const names = new Map((users ?? []).map((u) => [u.id, u.display_name]));
  return NextResponse.json({
    tickets: (data ?? []).map((t) => ({ ...t, owner_name: names.get(t.owner_id) ?? null })),
  });
}

export async function PATCH(request: Request) {
  const auth = await requireAdmin(request);
  if ("error" in auth) return auth.error;
  const { user, service } = auth;
  const body = (await request.json().catch(() => ({}))) as {
    id?: string;
    admin_reply?: string;
    status?: string;
  };
  const id = (body.id ?? "").trim();
  if (!id) return NextResponse.json({ error: "Ticket id မရှိပါ။" }, { status: 400 });
  // A resolved ticket is closed for good — the admin cannot reply
  // to it again (and cannot reopen it from here). This is checked
  // server-side too, so a stale admin page cannot override it.
  const { data: existing } = await service
    .from("support_tickets")
    .select("id, status")
    .eq("id", id)
    .single();
  if (!existing) return NextResponse.json({ error: "Ticket ကို မတွေ့ပါ။" }, { status: 404 });
  if (existing.status === "resolved") {
    return NextResponse.json({ error: "ဒီ Ticket ကို ဖြေရှင်းပြီးပြီ — ထပ်ဖြေလို့ မရပါ။" }, { status: 400 });
  }
  const update: { admin_reply?: string; status?: string; updated_at?: string } = {};
  let replied = false;
  if (body.admin_reply !== undefined) {
    const reply = body.admin_reply.trim();
    if (reply.length > 2000) return NextResponse.json({ error: "အဖြေ စာလုံး 2000 ထက် မကျော်ရပါ။" }, { status: 400 });
    update.admin_reply = reply;
    replied = true;
  }
  if (body.status !== undefined) {
    if (!STATUSES.includes(body.status as (typeof STATUSES)[number])) {
      return NextResponse.json({ error: "Status မမှန်ပါ။" }, { status: 400 });
    }
    update.status = body.status;
  }
  if (Object.keys(update).length === 0) {
    return NextResponse.json({ error: "ပြင်စရာ မရှိပါ။" }, { status: 400 });
  }
  if (replied && !update.status) update.status = "in_progress";
  update.updated_at = new Date().toISOString();
  const { data, error } = await service
    .from("support_tickets")
    .update(update)
    .eq("id", id)
    .select("id, owner_id, subject, status")
    .single();
  if (error || !data) return NextResponse.json({ error: "Ticket ပြင်၍ မရပါ။" }, { status: 502 });
  if (replied) await logAudit(service, user.id, "support_reply", id, data.subject);
  if (update.status) await logAudit(service, user.id, "support_status", id, `${data.subject} → ${update.status}`);
  if (update.status === "resolved") {
    await notifyUser(service, data.owner_id, "support_resolved", data.subject, "/support#tickets");
  } else if (replied) {
    await notifyUser(service, data.owner_id, "support_reply", data.subject, "/support#tickets");
  }
  return NextResponse.json({ ok: true, status: data.status });
}
</file>

<file path="src/app/api/brands/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

async function auth(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  return { user, service };
}

export async function GET(request: Request) {
  const { user, service } = await auth(request);
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ Brands ကြည့်လို့ရမယ်။" }, { status: 401 });
  }
  const { data, error } = await service
    .from("brands")
    .select("id, name, business_type, created_at")
    .eq("owner_id", user.id)
    .order("created_at", { ascending: false });
  if (error) return NextResponse.json({ error: "Brands ဖတ်လို့ မရပါ။" }, { status: 502 });
  return NextResponse.json({ brands: data ?? [] });
}

export async function POST(request: Request) {
  const { user, service } = await auth(request);
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ Brand ထည့်လို့ရမယ်။" }, { status: 401 });
  }
  const body = (await request.json()) as { name?: string; businessType?: string };
  const name = (body.name ?? "").trim();
  if (!name) return NextResponse.json({ error: "Brand အမည် ရေးပေးပါ။" }, { status: 400 });
  // Preserve an existing display_name (e.g. the name typed at
  // signup) — the old upsert overwrote it with the email prefix
  // on every API call.
  const { data: existingProfile } = await service
    .from("profiles")
    .select("id")
    .eq("id", user.id)
    .single();
  if (!existingProfile) {
    await service.from("profiles").insert({
      id: user.id,
      display_name:
        (user.user_metadata?.display_name as string | undefined) ??
        user.email?.split("@")[0] ??
        null,
    });
  }
  const { data, error } = await service
    .from("brands")
    .insert({ owner_id: user.id, name, business_type: body.businessType ?? null })
    .select("id, name, business_type, created_at")
    .single();
  if (error) return NextResponse.json({ error: "Brand သိမ်းလို့ မရပါ။" }, { status: 502 });
  return NextResponse.json({ brand: data });
}

export async function DELETE(request: Request) {
  const { user, service } = await auth(request);
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ဖျက်လို့ရမယ်။" }, { status: 401 });
  }
  const id = new URL(request.url).searchParams.get("id");
  if (!id) return NextResponse.json({ error: "Brand id မရှိပါ။" }, { status: 400 });
  // Return 404 when nothing was deleted (wrong id, or another
  // customer's brand) instead of a false ok — the old code always
  // returned ok, even for a brand that was never yours.
  const { data, error } = await service
    .from("brands")
    .delete()
    .eq("id", id)
    .eq("owner_id", user.id)
    .select("id");
  if (error) return NextResponse.json({ error: "Brand ဖျက်လို့ မရပါ။" }, { status: 502 });
  if (!data || data.length === 0) {
    return NextResponse.json({ error: "ဒီ Brand ကို မတွေ့ပါ။" }, { status: 404 });
  }
  return NextResponse.json({ ok: true });
}
</file>

<file path="src/app/api/designs/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

/* Designs are saved prompt records (not image blobs — image storage
   in a Storage bucket is the next step). A design stores prompt,
   channel, format and cost, so it can be re-created from /create. */
async function auth(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  return { user, service };
}

export async function GET(request: Request) {
  const { user, service } = await auth(request);
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ Designs ကြည့်လို့ရမယ်။" }, { status: 401 });
  }
  const { data, error } = await service
    .from("designs")
    .select("id, prompt, channel, format, created_at")
    .eq("owner_id", user.id)
    .order("created_at", { ascending: false });
  if (error) return NextResponse.json({ error: "Designs ဖတ်လို့ မရပါ။" }, { status: 502 });
  return NextResponse.json({ designs: data ?? [] });
}

export async function POST(request: Request) {
  const { user, service } = await auth(request);
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ Design သိမ်းလို့ရမယ်။" }, { status: 401 });
  }
  const body = (await request.json()) as {
    prompt?: string;
    channel?: string;
    format?: string;
  };
  const prompt = (body.prompt ?? "").trim();
  if (!prompt) return NextResponse.json({ error: "Prompt မရှိပါ။" }, { status: 400 });
  // Preserve an existing display_name (e.g. the name typed at
  // signup) — the old upsert overwrote it with the email prefix
  // on every API call.
  const { data: existingProfile } = await service
    .from("profiles")
    .select("id")
    .eq("id", user.id)
    .single();
  if (!existingProfile) {
    await service.from("profiles").insert({
      id: user.id,
      display_name:
        (user.user_metadata?.display_name as string | undefined) ??
        user.email?.split("@")[0] ??
        null,
    });
  }
  const { data, error } = await service
    .from("designs")
    .insert({
      owner_id: user.id,
      prompt,
      channel: body.channel ?? null,
      format: body.format ?? null,
    })
    .select("id, prompt, channel, format, created_at")
    .single();
  if (error) return NextResponse.json({ error: "Design သိမ်းလို့ မရပါ။" }, { status: 502 });
  return NextResponse.json({ design: data });
}

export async function DELETE(request: Request) {
  const { user, service } = await auth(request);
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ဖျက်လို့ရမယ်။" }, { status: 401 });
  }
  const id = new URL(request.url).searchParams.get("id");
  if (!id) return NextResponse.json({ error: "Design id မရှိပါ။" }, { status: 400 });
  // Return 404 when nothing was deleted (wrong id, or another
  // customer's design) instead of a false ok — the old code always
  // returned ok, even for a design that was never yours.
  const { data, error } = await service
    .from("designs")
    .delete()
    .eq("id", id)
    .eq("owner_id", user.id)
    .select("id");
  if (error) return NextResponse.json({ error: "Design ဖျက်လို့ မရပါ။" }, { status: 502 });
  if (!data || data.length === 0) {
    return NextResponse.json({ error: "ဒီ Design ကို မတွေ့ပါ။" }, { status: 404 });
  }
  return NextResponse.json({ ok: true });
}
</file>

<file path="src/app/auth/confirm/page.tsx">
"use client";

import { Suspense, useEffect, useState } from "react";
import Link from "next/link";
import { useRouter, useSearchParams } from "next/navigation";
import { getSupabase, supabaseConfigured } from "@/lib/supabase/client";
import { useLanguage } from "@/components/LanguageProvider";

function ConfirmInner() {
  const { t } = useLanguage();
  const router = useRouter();
  const searchParams = useSearchParams();
  const [status, setStatus] = useState<"working" | "done" | "error">(
    supabaseConfigured() ? "working" : "error",
  );
  const [error, setError] = useState(
    supabaseConfigured() ? "" : t("common.supabaseNotConnected"),
  );

  useEffect(() => {
    const supabase = getSupabase();
    if (!supabase) return;
    const code = searchParams.get("code");
    const hash = new URLSearchParams(window.location.hash.replace(/^#/, ""));
    const hashError = hash.get("error_description") ?? searchParams.get("error_description");
    if (hashError) {
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setStatus("error");
      const lower = hashError.toLowerCase();
      if (lower.includes("expired")) {
        setError(t("confirm.errExpired"));
      } else {
        setError(t("confirm.errInvalid"));
      }
      return;
    }
    (async () => {
      if (code) {
        const { error: err } = await supabase.auth.exchangeCodeForSession(code);
        if (err) {
          setStatus("error");
          setError(t("confirm.errExpiredOrInvalid"));
          return;
        }
      }
      const { data } = await supabase.auth.getSession();
      if (data.session) {
        setStatus("done");
        router.replace("/create");
      } else {
        setStatus("error");
        setError(t("confirm.errNoSession"));
      }
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [router, searchParams]);

  return (
    <main className="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-4 py-12">
      <div className="flex flex-col items-center gap-5 rounded-3xl border border-thukha-lilac/30 bg-white/75 p-8 text-center shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-thukha-indigo/70">
        <h1 className="text-2xl font-black sm:text-3xl">
          <span className="colorful-text-gradient">{t("confirm.title")}</span>
        </h1>

        {status === "working" && (
          <div className="flex flex-col items-center gap-3">
            <div className="h-10 w-10 animate-spin rounded-full border-3 border-thukha-violet border-t-transparent shadow-lg" />
            <p className="text-sm font-semibold text-thukha-indigo/70 dark:text-white/70">{t("confirm.working")}</p>
          </div>
        )}

        {status === "done" && (
          <div className="anim-scale-in flex flex-col items-center gap-3">
            <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-500 text-2xl text-white shadow-lg">
              ✓
            </div>
            <p className="text-sm font-semibold text-thukha-indigo/80 dark:text-white/80">{t("confirm.done")}</p>
          </div>
        )}

        {status === "error" && (
          <div className="anim-scale-in space-y-4">
            <p className="rounded-2xl border border-rose-300 bg-rose-50 p-4 text-sm leading-6 text-rose-900 shadow-sm dark:border-rose-800 dark:bg-rose-950/80 dark:text-rose-200">
              ⚠️ {error}
            </p>
            <p className="text-sm text-thukha-indigo/70 dark:text-white/70">
              <Link href="/signup" className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal">
                {t("common.goToSignup")}
              </Link>
              {" · "}
              <Link href="/login" className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal">
                {t("common.loginLink")}
              </Link>
            </p>
          </div>
        )}
      </div>
    </main>
  );
}

export default function ConfirmPage() {
  return (
    <Suspense>
      <ConfirmInner />
    </Suspense>
  );
}
</file>

<file path="src/app/auth/reset-password/page.tsx">
"use client";

import { Suspense, useEffect, useState } from "react";
import Link from "next/link";
import { useSearchParams } from "next/navigation";
import { getSupabase, supabaseConfigured } from "@/lib/supabase/client";
import { useLanguage } from "@/components/LanguageProvider";

const inputClass =
  "w-full rounded-xl border border-thukha-lilac/40 bg-white/90 dark:bg-[#1b1c48]/90 px-3.5 py-3 text-base text-thukha-indigo dark:text-[#f6f7fb] outline-none transition-all duration-200 focus:border-thukha-violet focus:ring-4 focus:ring-thukha-violet/20 focus:shadow-[0_0_15px_rgba(89,70,237,0.25)]";

function ResetInner() {
  const searchParams = useSearchParams();
  const { t } = useLanguage();
  const [phase, setPhase] = useState<"working" | "form" | "done" | "error">(
    supabaseConfigured() ? "working" : "error",
  );
  const [error, setError] = useState(
    supabaseConfigured() ? "" : t("common.supabaseNotConnected"),
  );
  const [password, setPassword] = useState("");
  const [confirm, setConfirm] = useState("");
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    const supabase = getSupabase();
    if (!supabase) return;
    const code = searchParams.get("code");
    const hash = new URLSearchParams(window.location.hash.replace(/^#/, ""));
    const hashError = hash.get("error_description") ?? searchParams.get("error_description");
    if (hashError) {
      // eslint-disable-next-line react-hooks/set-state-in-effect
      setPhase("error");
      const lower = hashError.toLowerCase();
      setError(
        lower.includes("expired")
          ? t("reset.errExpired")
          : t("reset.errInvalid"),
      );
      return;
    }
    (async () => {
      if (code) {
        const { error: err } = await supabase.auth.exchangeCodeForSession(code);
        if (err) {
          setPhase("error");
          setError(t("reset.errExpiredOrInvalid"));
          return;
        }
      }
      const { data } = await supabase.auth.getSession();
      if (data.session) {
        setPhase("form");
      } else {
        setPhase("error");
        setError(t("reset.errNoSession"));
      }
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [searchParams]);

  async function updatePassword() {
    if (password.length < 8) {
      setError(t("reset.errMin"));
      return;
    }
    if (password !== confirm) {
      setError(t("reset.errMatch"));
      return;
    }
    setLoading(true);
    setError("");
    const supabase = getSupabase();
    const { error: err } = await supabase!.auth.updateUser({ password });
    setLoading(false);
    if (err) {
      const msg = err.message.toLowerCase();
      if (msg.includes("same") || msg.includes("different")) {
        setError(t("reset.errSame"));
      } else if (msg.includes("weak") || msg.includes("short")) {
        setError(t("reset.errWeak"));
      } else {
        setError(t("reset.errGeneric"));
      }
      return;
    }
    await supabase!.auth.signOut();
    setPhase("done");
  }

  return (
    <main className="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-4 py-12">
      <div className="flex flex-col gap-5 rounded-3xl border border-thukha-lilac/30 bg-white/75 p-6 shadow-xl backdrop-blur-xl sm:p-8 dark:border-white/10 dark:bg-thukha-indigo/70">
        <div>
          <span className="inline-flex items-center gap-1.5 rounded-full bg-thukha-violet/10 px-3 py-1 text-xs font-bold text-thukha-violet dark:bg-white/10 dark:text-thukha-lilac">
            🔒 Secure Password Update
          </span>
          <h1 className="mt-2 text-2xl font-black tracking-tight sm:text-3xl">
            <span className="colorful-text-gradient">{t("reset.title")}</span>
          </h1>
        </div>

        {phase === "working" && (
          <div className="flex flex-col items-center gap-3 py-6">
            <div className="h-10 w-10 animate-spin rounded-full border-3 border-thukha-violet border-t-transparent shadow-lg" />
            <p className="text-sm font-semibold text-thukha-indigo/70 dark:text-white/70">{t("reset.checking")}</p>
          </div>
        )}

        {phase === "form" && (
          <>
            <p className="text-sm leading-relaxed text-thukha-indigo/70 dark:text-white/70">
              {t("reset.intro")}
            </p>
            <label className="text-xs font-bold uppercase tracking-wider text-thukha-indigo dark:text-[#f6f7fb]">
              {t("reset.new")}
              <input
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                type="password"
                className={`${inputClass} mt-1`}
              />
            </label>
            <label className="text-xs font-bold uppercase tracking-wider text-thukha-indigo dark:text-[#f6f7fb]">
              {t("reset.newAgain")}
              <input
                value={confirm}
                onChange={(e) => setConfirm(e.target.value)}
                type="password"
                className={`${inputClass} mt-1`}
              />
            </label>
            {error && (
              <p className="anim-scale-in rounded-xl border border-rose-300 bg-rose-50 p-3.5 text-sm text-rose-900 shadow-sm dark:border-rose-800 dark:bg-rose-950/80 dark:text-rose-200">
                ⚠️ {error}
              </p>
            )}
            <button
              type="button"
              onClick={updatePassword}
              disabled={loading}
              className="colorful-btn-gradient shimmer-hover min-h-[46px] rounded-xl px-6 py-3 font-bold text-white shadow-lg disabled:opacity-50"
            >
              {loading ? (
                <span className="flex items-center justify-center gap-2">
                  <span className="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent" />
                  {t("reset.updating")}
                </span>
              ) : (
                `${t("reset.update")} →`
              )}
            </button>
          </>
        )}

        {phase === "done" && (
          <div className="anim-scale-in space-y-4">
            <p className="rounded-2xl border border-teal-300 bg-teal-50 p-4 text-sm leading-6 text-teal-900 shadow-sm dark:border-teal-800 dark:bg-teal-950/80 dark:text-teal-200">
              ✓ {t("reset.done")}
            </p>
            <Link
              href="/login"
              className="colorful-btn-gradient shimmer-hover inline-flex min-h-[44px] w-full items-center justify-center rounded-xl px-6 py-2.5 font-bold text-white shadow-md"
            >
              {t("common.goToLogin")} →
            </Link>
          </div>
        )}

        {phase === "error" && (
          <div className="anim-scale-in space-y-4">
            <p className="rounded-2xl border border-rose-300 bg-rose-50 p-4 text-sm leading-6 text-rose-900 shadow-sm dark:border-rose-800 dark:bg-rose-950/80 dark:text-rose-200">
              ⚠️ {error}
            </p>
            <p className="text-sm text-thukha-indigo/70 dark:text-white/70">
              <Link href="/forgot-password" className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal">
                {t("reset.newLink")}
              </Link>
              {" · "}
              <Link href="/login" className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal">
                {t("common.loginLink")}
              </Link>
            </p>
          </div>
        )}
      </div>
    </main>
  );
}

export default function AuthResetPasswordPage() {
  const { t } = useLanguage();
  return (
    <Suspense
      fallback={
        <main className="mx-auto flex w-full max-w-md flex-1 items-center justify-center px-6 py-16">
          <p className="text-sm font-semibold text-thukha-indigo/70 dark:text-white/70">{t("reset.checking")}</p>
        </main>
      }
    >
      <ResetInner />
    </Suspense>
  );
}
</file>

<file path="src/app/forgot-password/page.tsx">
"use client";

import { useState } from "react";
import Link from "next/link";
import { getSupabase, supabaseConfigured } from "@/lib/supabase/client";
import { useLanguage } from "@/components/LanguageProvider";

const inputClass =
  "w-full rounded-xl border border-thukha-lilac/40 bg-white/90 dark:bg-[#1b1c48]/90 px-3.5 py-3 text-base text-thukha-indigo dark:text-[#f6f7fb] outline-none transition-all duration-200 focus:border-thukha-violet focus:ring-4 focus:ring-thukha-violet/20 focus:shadow-[0_0_15px_rgba(89,70,237,0.25)]";

export default function ForgotPasswordPage() {
  const { t } = useLanguage();
  const [email, setEmail] = useState("");
  const [error, setError] = useState("");
  const [sent, setSent] = useState(false);
  const [loading, setLoading] = useState(false);

  if (!supabaseConfigured()) {
    return (
      <main className="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-4 py-12">
        <div className="rounded-3xl border border-thukha-lilac/30 bg-white/70 p-8 shadow-xl backdrop-blur-xl dark:border-white/10 dark:bg-thukha-indigo/70">
          <h1 className="text-3xl font-black">{t("forgot.title")}</h1>
          <p className="mt-3 leading-7 text-thukha-indigo/70 dark:text-white/70">
            {t("common.supabaseEnvNote")} {t("forgot.notConnectedNote")}
          </p>
          <Link href="/login" className="colorful-btn-gradient shimmer-hover mt-6 inline-flex min-h-[44px] items-center justify-center rounded-full px-6 py-2.5 font-bold text-white shadow-md">
            {t("common.goToLogin")} →
          </Link>
        </div>
      </main>
    );
  }

  async function sendReset() {
    if (!email.trim()) {
      setError(t("forgot.errEmail"));
      return;
    }
    setLoading(true);
    setError("");
    const supabase = getSupabase();
    const { error: err } = await supabase!.auth.resetPasswordForEmail(email.trim(), {
      redirectTo: `${window.location.origin}/auth/reset-password`,
    });
    setLoading(false);
    if (err) {
      const msg = err.message.toLowerCase();
      if (msg.includes("too many") || msg.includes("rate")) {
        setError(t("forgot.errRate"));
      } else {
        setError(t("forgot.errGeneric"));
      }
      return;
    }
    setSent(true);
  }

  return (
    <main className="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-4 py-12">
      <div className="flex flex-col gap-5 rounded-3xl border border-thukha-lilac/30 bg-white/75 p-6 shadow-xl backdrop-blur-xl sm:p-8 dark:border-white/10 dark:bg-thukha-indigo/70">
        <div>
          <span className="inline-flex items-center gap-1.5 rounded-full bg-thukha-violet/10 px-3 py-1 text-xs font-bold text-thukha-violet dark:bg-white/10 dark:text-thukha-lilac">
            🔑 Account Recovery
          </span>
          <h1 className="mt-2 text-2xl font-black tracking-tight sm:text-3xl">
            <span className="colorful-text-gradient">{t("forgot.title")}</span>
          </h1>
        </div>

        {sent ? (
          <div className="anim-scale-in space-y-4">
            <p className="rounded-2xl border border-teal-300 bg-teal-50 p-4 text-sm leading-6 text-teal-900 shadow-sm dark:border-teal-800 dark:bg-teal-950/80 dark:text-teal-200">
              ✓ {t("forgot.sent")}
            </p>
            <p className="text-sm text-thukha-indigo/70 dark:text-white/70">
              {t("forgot.notArrived")}{" "}
              <button
                type="button"
                onClick={() => setSent(false)}
                className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal"
              >
                {t("forgot.resend")}
              </button>
              {" · "}
              <Link
                href="/login"
                className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal"
              >
                {t("common.goToLogin")}
              </Link>
            </p>
          </div>
        ) : (
          <>
            <p className="text-sm leading-relaxed text-thukha-indigo/70 dark:text-white/70">
              {t("forgot.intro")}
            </p>
            <label className="text-xs font-bold uppercase tracking-wider text-thukha-indigo dark:text-[#f6f7fb]">
              Email
              <input
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                type="email"
                placeholder="name@company.com"
                className={`${inputClass} mt-1`}
              />
            </label>
            {error && (
              <p className="anim-scale-in rounded-xl border border-rose-300 bg-rose-50 p-3.5 text-sm text-rose-900 shadow-sm dark:border-rose-800 dark:bg-rose-950/80 dark:text-rose-200">
                ⚠️ {error}
              </p>
            )}
            <button
              type="button"
              onClick={sendReset}
              disabled={loading}
              className="colorful-btn-gradient shimmer-hover min-h-[46px] rounded-xl px-6 py-3 font-bold text-white shadow-lg disabled:opacity-50"
            >
              {loading ? (
                <span className="flex items-center justify-center gap-2">
                  <span className="h-4 w-4 animate-spin rounded-full border-2 border-white border-t-transparent" />
                  {t("forgot.sending")}
                </span>
              ) : (
                `${t("forgot.send")} →`
              )}
            </button>
            <p className="border-t border-thukha-lilac/20 pt-3 text-center text-sm text-thukha-indigo/70 dark:border-white/10 dark:text-white/70">
              {t("forgot.remembered")}{" "}
              <Link
                href="/login"
                className="font-bold text-thukha-violet transition-colors hover:text-thukha-teal dark:text-thukha-lilac dark:hover:text-thukha-teal"
              >
                {t("common.loginLink")}
              </Link>
            </p>
          </>
        )}
      </div>
    </main>
  );
}
