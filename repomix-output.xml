import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";

/* Admin flag / unflag a generation for review. Flagging does NOT
   delete it and does NOT hide it from its owner — it only marks
   it in the admin list. Deletion stays a separate, audited action. */
export async function POST(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) return NextResponse.json({ error: "Login လုပ်ပြီးမှ လုပ်လို့ရမယ်။" }, { status: 401 });
  const { data: profile } = await service.from("profiles").select("role").eq("id", user.id).single();
  if (profile?.role !== "admin") return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  const body = (await request.json().catch(() => ({}))) as { id?: string; flagged?: boolean };
  const id = (body.id ?? "").trim();
  const flagged = body.flagged === true;
  if (!id) return NextResponse.json({ error: "Generation id မရှိပါ။" }, { status: 400 });
  const { data: gen, error } = await service.from("generations").update({ flagged }).eq("id", id).select("id, owner_id").single();
  if (error || !gen) return NextResponse.json({ error: "ဒီ generation ကို မတွေ့ပါ။" }, { status: 404 });
  await logAudit(service, user.id, flagged ? "flag" : "unflag", id, gen.owner_id ?? null);
  return NextResponse.json({ ok: true, flagged });
}
</file>

<file path="src/app/api/admin/maintenance/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";

/* Admin-only maintenance switch: temporarily close login + signup
   for customers. Admins can still log in — the login page checks
   the role after sign-in and only turns customers away — so the
   admin can always get back in to reopen it. */
export async function POST(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ လုပ်လို့ရမယ်။" }, { status: 401 });
  }
  const { data: profile } = await service
    .from("profiles")
    .select("role")
    .eq("id", user.id)
    .single();
  if (profile?.role !== "admin") {
    return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  }
  const body = (await request.json().catch(() => ({}))) as { maintenance?: boolean };
  const on = body.maintenance === true;
  const { error } = await service.from("app_settings").upsert(
    { key: "maintenance", value: on ? "true" : "false", updated_at: new Date().toISOString() },
    { onConflict: "key" },
  );
  if (error) return NextResponse.json({ error: "သိမ်း၍ မရပါ။ ထပ်ကြိုးစားပါ။" }, { status: 502 });
  await logAudit(service, user.id, on ? "maintenance_on" : "maintenance_off", null, null);
  return NextResponse.json({ ok: true, maintenance: on });
}
</file>

<file path="src/app/api/announcements/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase } from "@/lib/supabase/server";

/* Public broadcast read: only ACTIVE announcements, newest
   first. No private data in an announcement — title/body are
   written by an admin for all customers, so no auth is needed
   to read them (the same banner shows to guests on /create). */
export async function GET() {
  const service = getServiceSupabase();
  if (!service) return NextResponse.json({ announcements: [] });
  const { data } = await service.from("announcements").select("id, title, body, created_at").eq("active", true).order("created_at", { ascending: false }).limit(10);
  return NextResponse.json({ announcements: data ?? [] });
}
