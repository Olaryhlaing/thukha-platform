<file path="src/app/api/account/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

/* Delete my account (privacy: right to erasure). Deletes, in order:
   usage_events, generations, designs, brands, token_balances,
   profiles — then the Supabase Auth user itself via the service_role
   admin API. The deletes are explicit (not left to ON DELETE SET
   NULL) so a prompt log cannot survive with a null owner after
   the account is gone. Deleting the profile first and the Auth
   user last is safe: both deletes are idempotent, so if the Auth
   delete fails the customer can retry and it will finish.
   Only the account owner can call this (their own Bearer token);
   an admin cannot delete someone else's account through this route. */
export async function DELETE(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json(
      { error: "Login လုပ်ပြီးမှ Account ဖျက်လို့ရမယ်။" },
      { status: 401 },
    );
  }
  const id = user.id;
  // Erase the profile picture too, or a public avatar file would
  // survive after the account is gone. Best-effort: a missing
  // bucket must not block the account delete.
  try {
    const { data: avatarFiles } = await service.storage.from("avatars").list(id);
    if (avatarFiles && avatarFiles.length > 0) {
      await service.storage.from("avatars").remove(avatarFiles.map((f) => `${id}/${f.name}`));
    }
  } catch {
    // Account delete continues below regardless.
  }
  await service.from("usage_events").delete().eq("owner_id", id);
  await service.from("generations").delete().eq("owner_id", id);
  await service.from("designs").delete().eq("owner_id", id);
  await service.from("brands").delete().eq("owner_id", id);
  await service.from("token_balances").delete().eq("owner_id", id);
  await service.from("profiles").delete().eq("id", id);
  const { error: authError } = await service.auth.admin.deleteUser(id);
  if (authError) {
    console.error("Account delete: auth user delete failed", authError.message);
    return NextResponse.json(
      { error: "Account data ဖျက်ပြီးပြီ၊ ဒါပေမယ့် Login account ဖျက်လို့ မရသေးပါ။ ထပ်ကြိုးစားပါ။" },
      { status: 502 },
    );
  }
  return NextResponse.json({ ok: true });
}
</file>

<file path="src/app/api/admin/announcements/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";
import { notifyCustomers } from "@/lib/notify";

async function admin(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) return null;
  const { data: profile } = await service.from("profiles").select("role").eq("id", user.id).single();
  if (profile?.role !== "admin") return null;
  return { user, service };
}

/* Admin announcement list (active + inactive, for management). */
export async function GET(request: Request) {
  const a = await admin(request);
  if (!a) return NextResponse.json({ error: "Admin မဟုတ်လို့ ကြည့်လို့ မရပါ။" }, { status: 403 });
  const { data } = await a.service.from("announcements").select("id, title, body, active, created_at").order("created_at", { ascending: false }).limit(50);
  return NextResponse.json({ announcements: data ?? [] });
}

/* Admin create an announcement. Deactivation (not deletion)
   keeps history — see PATCH. */
export async function POST(request: Request) {
  const a = await admin(request);
  if (!a) return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  const body = (await request.json().catch(() => ({}))) as { title?: string; body?: string };
  const title = (body.title ?? "").trim();
  const bodyText = (body.body ?? "").trim();
  if (!title || !bodyText) return NextResponse.json({ error: "Title နဲ့ Body နှစ်ခုလုံး ရေးပေးပါ။" }, { status: 400 });
  if (title.length > 200 || bodyText.length > 2000) return NextResponse.json({ error: "Title 200 လုံး၊ Body 2000 လုံးထက် မကျော်ရပါ။" }, { status: 400 });
  const { data, error } = await a.service.from("announcements").insert({ title, body: bodyText, active: true, created_by: a.user.id }).select("id").single();
  if (error || !data) return NextResponse.json({ error: "Announcement သိမ်း၍ မရပါ။" }, { status: 502 });
  await logAudit(a.service, a.user.id, "announcement_create", data.id, title);
  await notifyCustomers(a.service, "announcement", title, "/create");
  return NextResponse.json({ ok: true, id: data.id });
}

/* Admin activate / deactivate an announcement. */
export async function PATCH(request: Request) {
  const a = await admin(request);
  if (!a) return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  const body = (await request.json().catch(() => ({}))) as { id?: string; active?: boolean };
  const id = (body.id ?? "").trim();
  const active = body.active === true;
  if (!id) return NextResponse.json({ error: "Announcement id မရှိပါ။" }, { status: 400 });
  const { data, error } = await a.service.from("announcements").update({ active }).eq("id", id).select("id, title").single();
  if (error || !data) return NextResponse.json({ error: "Announcement ကို မတွေ့ပါ။" }, { status: 404 });
  await logAudit(a.service, a.user.id, active ? "announcement_activate" : "announcement_deactivate", id, data.title ?? null);
  return NextResponse.json({ ok: true, active });
}
</file>

<file path="src/app/api/admin/generations/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";

/* Admin-only generation delete: removes one generations log row
   (prompt/model/cost record only — images are never stored as
   blobs, so there is nothing else to clean up). Admin-only
   (profiles.role = 'admin', checked server-side, 403 otherwise).
   Deleting the log does NOT refund tokens — a refund, if ever
   wanted, is a separate token_balances change. Returns 404 when
   the id does not exist, so the client only removes the row
   locally on a real server delete. */
export async function DELETE(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ လုပ်လို့ရမယ်။" }, { status: 401 });
  }
  const { data: profile } = await service
    .from("profiles")
    .select("role")
    .eq("id", user.id)
    .single();
  if (profile?.role !== "admin") {
    return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  }
  const body = (await request.json()) as { id?: string };
  const id = (body.id ?? "").trim();
  if (!id) {
    return NextResponse.json({ error: "Generation id မရှိပါ။" }, { status: 400 });
  }
  const { data: deleted, error } = await service
    .from("generations")
    .delete()
    .eq("id", id)
    .select("id, owner_id")
    .single();
  if (error || !deleted) {
    return NextResponse.json({ error: "ဒီ generation ကို မတွေ့ပါ။" }, { status: 404 });
  }
  await logAudit(service, user.id, "delete_generation", id, deleted.owner_id ?? null);
  return NextResponse.json({ ok: true });
}
</file>

<file path="src/app/api/admin/health/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

/* Admin system health, from tables that already exist. Failures
   are NOT logged (only successful generations are), so this page
   cannot show a failure rate yet — that needs failure logging
   (Batch 2). Today's count is a proxy for the Cloudflare daily
   quota (~170 images/day estimate): the provider does not expose
   exact remaining neurons via API, and if other apps share this
   Cloudflare account the real remaining quota is lower. */
export async function GET(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) return NextResponse.json({ error: "Login လုပ်ပြီးမှ ကြည့်လို့ရမယ်။" }, { status: 401 });
  const { data: profile } = await service.from("profiles").select("role").eq("id", user.id).single();
  if (profile?.role !== "admin") return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  const startToday = new Date(); startToday.setUTCHours(0, 0, 0, 0);
  const [{ data: todayGens }, { data: allGens }, { count: userCount }, { data: todayFails }, { data: allFails }] = await Promise.all([
    service.from("generations").select("cost_tokens").gte("created_at", startToday.toISOString()),
    service.from("generations").select("cost_tokens"),
    service.from("profiles").select("id", { count: "exact", head: true }),
    service.from("generation_failures").select("id").gte("created_at", startToday.toISOString()),
    service.from("generation_failures").select("id"),
  ]);
  const today = todayGens ?? [];
  const all = allGens ?? [];
  const failsToday = (todayFails ?? []).length;
  const failsTotal = (allFails ?? []).length;
  const attemptsTotal = all.length + failsTotal;
  return NextResponse.json({
    todayGenerations: today.length,
    todaySpent: today.reduce((s, g) => s + (g.cost_tokens ?? 0), 0),
    totalGenerations: all.length,
    totalSpent: all.reduce((s, g) => s + (g.cost_tokens ?? 0), 0),
    users: userCount ?? 0,
    estimatedQuotaLeft: Math.max(0, 170 - today.length),
    failuresToday: failsToday,
    failuresTotal: failsTotal,
    // Failure rate is only meaningful from Batch 2 onward, when
    // failures started being logged — older attempts have no
    // failure rows, so an old period would understate the rate.
    failureRate: attemptsTotal > 0 ? Math.round((failsTotal / attemptsTotal) * 1000) / 10 : 0,
  });
}
</file>

<file path="src/app/api/admin/suspend/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";
import { notifyUser } from "@/lib/notify";

/* Admin suspend / unsuspend a customer. Cannot suspend yourself
   and cannot suspend another admin — an admin lockout would
   leave no one to unsuspend. Suspended customers can still log
   in and view /account (so they see the suspension), but the
   generate route blocks them with 403. */
export async function POST(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) return NextResponse.json({ error: "Login လုပ်ပြီးမှ လုပ်လို့ရမယ်။" }, { status: 401 });
  const { data: profile } = await service.from("profiles").select("role").eq("id", user.id).single();
  if (profile?.role !== "admin") return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  const a = { user, service };
  const body = (await request.json().catch(() => ({}))) as { userId?: string; suspended?: boolean };
  const userId = (body.userId ?? "").trim();
  const suspended = body.suspended === true;
  if (!userId) return NextResponse.json({ error: "User id မရှိပါ။" }, { status: 400 });
  if (userId === user.id) return NextResponse.json({ error: "ကိုယ့်ကိုယ်ကို Suspend လုပ်လို့ မရပါ။" }, { status: 400 });
  const { data: target } = await service.from("profiles").select("id, role, display_name").eq("id", userId).single();
  if (!target) return NextResponse.json({ error: "ဒီ user ကို မတွေ့ပါ။" }, { status: 404 });
  if (target.role === "admin") return NextResponse.json({ error: "Admin ကို Suspend လုပ်လို့ မရပါ။" }, { status: 400 });
  const { error } = await service.from("profiles").update({ suspended }).eq("id", userId);
  if (error) return NextResponse.json({ error: "Suspend ပြောင်းလို့ မရပါ။" }, { status: 502 });
  await logAudit(service, user.id, suspended ? "suspend" : "unsuspend", userId, target.display_name ?? null);
  await notifyUser(service, userId, suspended ? "account_suspended" : "account_unsuspended", target.display_name ?? null, "/account");
  return NextResponse.json({ ok: true, suspended });
}
</file>

<file path="src/app/api/improve-prompt/route.ts">
import { NextResponse } from "next/server";
import { stripPersonalData } from "@/lib/privacy";

/* Prompt Assistant — professional, not just longer.
   Template version, no AI key needed: it turns the customer's
   rough idea into 3 distinct professional image prompts, each
   a complete advertising brief (subject + setting + light +
   composition + mood), not the same base with 3 adjective
   swaps. The idea itself is kept verbatim, so a Burmese idea
   is not mistranslated — professional English descriptors are
   wrapped around it, because image models understand those
   best. If a real text model is wired later, keep this same
   response shape: {options: string[]}.

   Professional structure (2026-11-02, user request: make
   suggestions the best and most professional):
   - Hero Studio: clean, centred, studio light — best for a
     product/menu card that must read instantly.
   - Lifestyle Scene: real everyday Myanmar/Thai setting,
     natural light, warm and trustworthy — best for brand
     trust and social feeds.
   - Premium Editorial: dramatic soft light, elegant
     composition with empty space for a headline — best for
     a launch or promotion that must look high-end.
   Each option is also tailored by business type (food,
   product, beauty, service, agency), by goal (sales, brand,
   promotion) and by channel (square post, vertical story,
   wide cover) — the channel the customer already chose in
   /create, so the composition matches where the image will
   actually be posted.

   Mode-aware (2026-11-02, AI-text mode): when the customer
   lets AI write the text in the image (renderText), the
   suggestions must NOT say "no text" — that would contradict
   the server's render instruction and confuse the model.
   They say "no logo, no watermark" only. In Overlay mode
   they keep "no text, no logo, no watermark" plus empty
   space for the headline, because the browser overlays the
   text later with 100% correct Burmese.

   Privacy: personal data is stripped from every field before
   it is echoed into a suggestion, so a phone/email in the
   idea can never reach an image provider through the prompt
   box (the generate route strips again, as a second layer). */

function businessDescriptor(type: string): string {
  if (type.includes("စားသောက်ဆိုင်")) {
    return "freshly prepared food, steam rising, vibrant natural ingredients, warm restaurant table setting";
  }
  if (type.includes("Online shop") || type.toLowerCase().includes("shop")) {
    return "product presented clearly, clean background, sharp product detail";
  }
  if (type.includes("အလှအပ")) {
    return "elegant beauty setting, soft diffused light, clean and fresh atmosphere, premium care products";
  }
  if (type.includes("ဝန်ဆောင်မှု")) {
    return "professional service in action, friendly and trustworthy, clean modern setting, real-life context";
  }
  if (type.includes("Agency")) {
    return "modern creative workspace, sleek contemporary design, professional and confident atmosphere";
  }
  return "clear subject, clean professional setting, attractive presentation";
}

function goalMood(goal: string): string {
  if (goal.includes("ရောင်း")) {
    return "appetizing and enticing, eye-catching, made to encourage customers to buy";
  }
  if (goal.includes("Brand")) {
    return "memorable and clean, consistent brand-style presentation that customers will recognise";
  }
  if (goal.includes("Promotion")) {
    return "festive and exciting, celebratory mood, vibrant colours that announce a special offer";
  }
  return "attractive and professional, made to stop the scroll on Facebook";
}

function channelComposition(channel: string): string {
  if (channel.includes("story") || channel.includes("Story")) {
    return "vertical composition, subject in the upper two-thirds, clean space below for a headline";
  }
  if (channel.includes("cover") || channel.includes("Cover")) {
    return "wide banner composition, subject to one side, clean empty space for a headline";
  }
  return "square composition, subject centred and balanced, with clean empty space at the top for a headline";
}

export async function POST(request: Request) {
  try {
    const body = (await request.json()) as {
      idea?: string;
      overlayText?: string;
      businessType?: string;
      businessName?: string;
      goal?: string;
      channel?: string;
      renderText?: boolean;
    };
    const idea = stripPersonalData((body.idea ?? "").trim().replace(/[.。]+$/, ""));
    const overlay = stripPersonalData((body.overlayText ?? "").trim());
    if (!idea && !overlay) {
      return NextResponse.json(
        { error: "အပေါ်မှာ စာ (ခေါင်းစဉ်) ဒါမှမဟုတ် prompt အကြမ်း တစ်ခု အရင် ရေးပေးပါ။" },
        { status: 400 },
      );
    }
    const businessType = stripPersonalData(body.businessType ?? "");
    const goal = stripPersonalData(body.goal ?? "");
    const channel = stripPersonalData(body.channel ?? "");
    // When there is an idea, the overlay text shapes its mood;
    // when there is only overlay text, it becomes the topic.
    const base = idea || `A scene matching the message "${overlay}"`;
    const mood = idea && overlay ? `, matching the message "${overlay}"` : "";
    const descriptor = businessDescriptor(businessType);
    const goalText = goalMood(goal);
    const composition = channelComposition(channel);
    const tail = body.renderText === true
      ? "no logo, no watermark"
      : "no text, no logo, no watermark, with clean empty space for a headline";
    const options = [
      // 1. Hero Studio — clean, instant, product-first.
      `Professional studio advertising photograph of ${base}${mood}: ${descriptor}, ${composition}, soft studio lighting, sharp focus, high detail, premium commercial quality, ${tail}`,
      // 2. Lifestyle Scene — real, warm, trustworthy.
      `Authentic lifestyle photograph of ${base}${mood}: ${descriptor}, natural light, real everyday Myanmar setting, warm and inviting atmosphere, candid and trustworthy, ${goalText}, professional photography, ${tail}`,
      // 3. Premium Editorial — high-end, headline-ready.
      `Premium editorial advertising image of ${base}${mood}: ${descriptor}, dramatic soft lighting, ${composition}, rich natural colours, high-end commercial quality, ${goalText}, ${tail}`,
    ];
    return NextResponse.json({ options, template: true });
  } catch {
    return NextResponse.json(
      { error: "Prompt suggestions ထုတ်လို့ မရသေးပါ။" },
      { status: 500 },
    );
  }
}
</file>

