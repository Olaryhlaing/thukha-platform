                      fontFamily: overlayFontStack,
                      color: overlayColor,
                      textAlign: overlayAlign,
                      textShadow: "0 2px 8px rgba(0,0,0,0.75)",
                      touchAction: "none",
                      left: custom
                        ? `${custom.x}%`
                        : overlayAlign === "left"
                          ? "0%"
                          : overlayAlign === "right"
                            ? "100%"
                            : "50%",
                      top: custom ? `${custom.y}%` : `${defaultY}%`,
                      transform: `translate(${alignX}, -50%)`,
                    }}
                  >
                    <span className="inline-block rounded-xl px-3 py-2" style={{ backgroundColor: bgColor }}>
                      {content}
                    </span>
                  </div>
                );
                return (
                  <>
                    {overlayHeadline.trim() &&
                      layer(
                        "head",
                        overlayCustomHead,
                        centerPct - offsetPct / 2,
                        <p
                          className={`font-bold leading-snug ${
                            overlaySize === "small"
                              ? "text-xl sm:text-2xl"
                              : overlaySize === "large"
                                ? "text-4xl sm:text-5xl"
                                : "text-2xl sm:text-3xl"
                          }`}
                        >
                          {overlayHeadline}
                        </p>,
                      )}
                    {showBrandName && businessName.trim() &&
                      layer(
                        "brand",
                        overlayCustomBrand,
                        92,
                        <p className="font-bold leading-snug text-lg sm:text-xl">
                          {businessName}
                        </p>,
                      )}
                    {overlaySub.trim() &&
                      layer(
                        "sub",
                        overlayCustomSub,
                        centerPct + offsetPct / 2,
                        <p
                          className={`leading-snug ${
                            overlaySize === "small" ? "text-sm" : overlaySize === "large" ? "text-xl" : "text-base"
                          }`}
                        >
                          {overlaySub}
                        </p>,
                      )}
                  </>
                );
              })()}
              </>)}
          {selected && isGuest && (
            <div className="pointer-events-none absolute inset-0 overflow-hidden rounded-2xl">
              <div className="absolute inset-x-0 top-0 bg-black/60 py-2 text-center text-xs font-bold text-white">
                {t("create.guestWatermark")}
              </div>
              <div className="absolute inset-0 flex items-center justify-center">
                <span className="whitespace-nowrap text-2xl font-black text-white/70 sm:text-3xl" style={{ transform: "rotate(-25deg)", textShadow: "0 2px 12px rgba(0,0,0,0.8)" }}>
                  ThuKha Preview
                </span>
              </div>
            </div>
          )}
        </div>
        {!selected && (overlayHeadline.trim() || overlaySub.trim()) && (
          <p className="text-sm leading-6 text-thukha-indigo dark:text-[#f6f7fb]">
            {t("create.dragHelp")}
          </p>
        )}
        {!selected && (overlayCustomHead || overlayCustomSub) && (
          <button
            type="button"
            onClick={() => {
              setOverlayCustomHead(null);
              setOverlayCustomSub(null);
              setOverlayCustomBrand(null);
            }}
            className="min-h-[44px] w-fit rounded-full border-2 border-thukha-violet px-6 py-2 text-sm font-bold text-thukha-violet dark:text-thukha-lilac"
          >
            {t("create.dragReset")}
          </button>
        )}
        {selected ? (
          <>
            {(overlayHeadline.trim() || overlaySub.trim()) && (
              <p className="text-sm leading-6 text-thukha-indigo dark:text-[#f6f7fb]">
                {t("create.layersHelp")}
              </p>
            )}
            {(overlayCustomHead || overlayCustomSub) && (
              <button
                type="button"
                onClick={() => {
                  setOverlayCustomHead(null);
                  setOverlayCustomSub(null);
                }}
                className="min-h-[44px] w-fit rounded-full border-2 border-thukha-violet px-6 py-2 text-sm font-bold text-thukha-violet dark:text-thukha-lilac"
              >
                {t("create.dragResetFull")}
              </button>
            )}
            {isGuest ? (
              <>
                <a href="/login" className="colorful-btn-gradient shimmer-hover flex min-h-[46px] items-center justify-center rounded-xl px-6 py-3 font-bold text-white shadow-md">
                  {t("create.downloadLoginCta")}
                </a>
              </>
            ) : (
              <>
                <button type="button" onClick={downloadWithText} className="colorful-btn-gradient shimmer-hover min-h-[46px] rounded-xl px-6 py-3 font-bold text-white shadow-lg">
                  {t("create.downloadWithText")}
                </button>
                {overlayMessage && <p className="anim-scale-in text-sm leading-6 text-thukha-indigo dark:text-[#f6f7fb]">{overlayMessage}</p>}
                <a href={selected} download="thukha-ai.png" className="flex min-h-[44px] items-center justify-center rounded-xl border-2 border-thukha-violet/40 bg-white/40 px-6 py-3 font-bold text-thukha-violet transition-all duration-200 hover:border-thukha-violet hover:bg-thukha-violet/10 hover:scale-[1.01] active:scale-[0.99] dark:border-thukha-lilac/40 dark:bg-white/5 dark:text-thukha-lilac dark:hover:border-thukha-lilac dark:hover:bg-white/10">
                  {t("create.downloadWithoutText")}
                </a>
              </>
            )}
            <button type="button" onClick={saveDesign} className="flex min-h-[44px] items-center justify-center rounded-xl border border-thukha-violet/30 bg-white/40 px-6 py-3 font-bold text-thukha-violet transition-all duration-200 hover:border-thukha-violet hover:bg-thukha-violet/10 hover:scale-[1.01] active:scale-[0.99] dark:border-white/10 dark:bg-white/5 dark:text-thukha-lilac dark:hover:bg-white/10">
              {t("create.saveDesign")}
            </button>
            {savedMessage && <p className="text-sm leading-6 text-thukha-indigo dark:text-[#f6f7fb]">{savedMessage}</p>}
            {/* Caption + hashtags for the Facebook post */}
            <div className="rounded-2xl border border-thukha-lilac/30 bg-white/40 p-4 dark:border-white/10 dark:bg-white/5">
              <h3 className="text-sm font-bold">{t("create.captionTitle")}</h3>
              <button
                type="button"
                onClick={generateCaption}
                disabled={captionLoading}
                className="mt-2 min-h-[44px] rounded-full bg-thukha-violet px-5 py-2 text-sm font-bold text-white disabled:opacity-50"
              >
                {captionLoading ? t("create.captionLoading") : t("create.captionButton")}
              </button>
              {captionMsg && <p className="mt-2 text-sm font-semibold">{captionMsg}</p>}
              {captionOptions.length > 0 && (
                <ul className="mt-3 flex flex-col gap-2">
                  {captionOptions.map((opt) => (
                    <li key={opt} className="flex items-start justify-between gap-2 rounded-xl bg-white/60 p-3 text-sm leading-6 dark:bg-black/20">
                      <span>{opt}</span>
                      <button
                        type="button"
                        onClick={() => copyCaption(opt)}
                        className="shrink-0 rounded-full border border-thukha-violet/40 px-3 py-1 text-xs font-bold text-thukha-violet dark:text-thukha-lilac"
                      >
                        {copiedCaption === opt ? t("create.captionCopied") : t("create.captionCopy")}
                      </button>
                    </li>
                  ))}
                </ul>
              )}
              {captionHashtags.length > 0 && (
                <p className="mt-2 text-sm text-thukha-violet dark:text-thukha-lilac">
                  {t("create.captionHashtags")}: {captionHashtags.join(" ")}
                </p>
              )}
              <p className="mt-2 text-xs leading-5 text-thukha-indigo/70 dark:text-white/70">{t("create.captionNote")}</p>
            </div>
          </>
        ) : null}
        {aiImages.length > 1 && (
          <div className="grid grid-cols-4 gap-3">
            {aiImages.map((url, i) => (
              <button key={url.slice(-32) + i} type="button" onClick={() => setSelected(url)} className={`overflow-hidden rounded-2xl ring-2 ${selected === url ? "ring-thukha-violet" : "ring-thukha-lilac/40"}`}>
                {/* eslint-disable-next-line @next/next/no-img-element */}
                <img src={url} alt={`${t("create.historyAlt")} ${i + 1}`} className="h-20 w-full object-cover sm:h-24" />
              </button>
            ))}
          </div>
        )}
      </section>
        </aside>
      </div>
    </main>
  );
}
</file>

<file path="src/components/SiteHeader.tsx">
"use client";

import Link from "next/link";
import Image from "next/image";
import { useState } from "react";
import { usePathname } from "next/navigation";
import AuthNav, { AdminAuditNavLink, AdminNavLink, AdminSupportNavLink, SupportNavLink } from "@/components/AuthNav";
import NotificationBell from "@/components/NotificationBell";
import ThemeToggle from "@/components/ThemeToggle";
import LanguageToggle from "@/components/LanguageToggle";
import { useLanguage } from "@/components/LanguageProvider";

const AUTH_PAGES = ["/login", "/signup", "/admin/login", "/forgot-password", "/auth/reset-password"];

export default function SiteHeader() {
  const pathname = usePathname();
  const isAuthPage = AUTH_PAGES.includes(pathname ?? "");
  const { t } = useLanguage();
  const [menuOpen, setMenuOpen] = useState(false);

  return (
    <header className="sticky top-0 z-50 border-b border-thukha-lilac/25 bg-[#EDE9FE] dark:border-white/10 dark:bg-[#1A1740]">
      {/* Animated colorful gradient line at the bottom of header */}
      <div className="absolute bottom-0 left-0 right-0 h-[2px] bg-gradient-to-r from-thukha-violet via-[#ec4899] via-thukha-teal to-thukha-lilac bg-[length:200%_auto] animate-[thu-gradient-flow_7s_linear_infinite]" />

      <div className="flex w-full flex-wrap items-center justify-between gap-x-2 gap-y-2 px-3 py-2.5 sm:px-5 sm:py-3">
        {/* Brand Logo with interactive colorful hover state */}
        <Link
          href="/"
          className="group order-1 flex shrink-0 items-center gap-2 whitespace-nowrap text-sm font-black tracking-tight transition-transform duration-200 hover:scale-[1.02] active:scale-[0.98] sm:gap-2.5 sm:text-base"
        >
          <div className="relative flex items-center justify-center">
            <div className="absolute -inset-1 rounded-2xl bg-gradient-to-tr from-thukha-violet to-thukha-teal opacity-0 blur transition-opacity duration-300 group-hover:opacity-60" />
            <Image
              src="/thukha-logo.png"
              alt="ThuKha Platform logo"
              width={40}
              height={40}
              className="relative h-8 w-8 rounded-xl bg-white shadow-sm transition-transform duration-300 group-hover:rotate-3 sm:h-9 sm:w-9 dark:bg-[#1b1c48]"
            />
          </div>
          <span className="colorful-brand-gradient">ThuKha Platform</span>
        </Link>

        {!isAuthPage && (
          <nav
            onClick={() => setMenuOpen(false)}
            className={`order-3 w-full flex-col gap-1.5 px-3 pb-3 text-sm font-semibold transition-all duration-300 sm:gap-2 lg:order-2 lg:flex lg:w-auto lg:flex-1 lg:flex-row lg:items-center lg:justify-center lg:gap-3 lg:px-0 lg:pb-0 ${
              menuOpen ? "flex anim-fade-in bg-[#EDE9FE] dark:bg-[#1A1740] rounded-2xl p-4 shadow-xl border border-thukha-lilac/30 lg:shadow-none lg:border-none lg:p-0" : "hidden"
            }`}
          >
            <Link
              href="/create"
              className="flex min-h-[40px] items-center rounded-xl px-3 py-1.5 text-thukha-violet transition-all duration-200 hover:bg-thukha-violet/10 hover:text-thukha-violet hover:scale-105 active:scale-95 dark:text-thukha-lilac dark:hover:bg-white/10"
            >
              {t("nav.create")}
            </Link>
            <Link
              href="/designs"
              className="flex min-h-[40px] items-center rounded-xl px-3 py-1.5 text-thukha-violet transition-all duration-200 hover:bg-thukha-violet/10 hover:text-thukha-violet hover:scale-105 active:scale-95 dark:text-thukha-lilac dark:hover:bg-white/10"
            >
              {t("nav.designs")}
            </Link>
            <SupportNavLink />
            <AdminNavLink />
            <AdminSupportNavLink />
            <AdminAuditNavLink />
            <div className="lg:hidden">
              <AuthNav />
            </div>
          </nav>
        )}

        <div className="order-2 flex shrink-0 items-center gap-1.5 sm:gap-2 lg:order-3">
          <NotificationBell />
          <LanguageToggle />
          <ThemeToggle />
          {/* Desktop only: logged-in pill (and guest links) sit here,
              after the toggles, so the avatar+name pill is the far
              right item on screen. Mobile keeps AuthNav inside the
              hamburger menu above, or the top row would crowd again.
              Auth pages show no AuthNav here, same as the nav. */}
          {!isAuthPage && (
            <div className="hidden lg:flex lg:items-center lg:gap-3">
              <AuthNav />
            </div>
          )}
          {!isAuthPage && (
            <button
              type="button"
              onClick={() => setMenuOpen((v) => !v)}
              aria-label={menuOpen ? t("nav.closeMenu") : t("nav.openMenu")}
              aria-expanded={menuOpen}
              className="flex min-h-[40px] min-w-[40px] items-center justify-center rounded-full border border-thukha-lilac/50 bg-white/50 text-xl font-bold text-thukha-violet transition-all duration-200 hover:border-thukha-violet hover:bg-thukha-violet/10 hover:scale-105 active:scale-95 lg:hidden dark:bg-white/5 dark:text-thukha-lilac dark:hover:bg-white/10"
            >
              {menuOpen ? "✕" : "☰"}
            </button>
          )}
        </div>
      </div>
    </header>
  );
}
