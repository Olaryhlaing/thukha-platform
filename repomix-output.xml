export const dict: Record<Lang, Dict> = { my, en };

export function translate(lang: Lang, key: string, vars?: Record<string, string | number>): string {
  const raw = dict[lang][key] ?? dict.my[key] ?? key;
  if (!vars) return raw;
  return raw.replace(/\{(\w+)\}/g, (_, name) =>
    vars[name] !== undefined ? String(vars[name]) : `{${name}}`,
  );
}

/* Map a known server-returned Burmese error to English when the
   UI language is English. Unknown messages pass through unchanged
   (better a Burmese reason than a wrong English one). The token
   message carries numbers, so it is matched by pattern. */
export function serverErrorText(lang: Lang, msg: string | undefined): string | undefined {
  if (lang !== "en" || !msg) return msg;
  const map: Record<string, string> = {
    "Brand သိမ်းလို့ မရပါ။": "Could not save the brand.",
    "Brand ဖျက်လို့ မရပါ။": "Could not delete the brand.",
    "Design သိမ်းလို့ မရပါ။": "Could not save the design.",
    "Design ဖျက်လို့ မရပါ။": "Could not delete the design.",
    "Admin data ဖတ်လို့ မရပါ။": "Could not read admin data.",
    "Token ဖြည့်လို့ မရပါ။": "Could not refill tokens.",
    "Generation ဖျက်လို့ မရပါ။": "Could not delete the generation.",
    "Token ဖြတ်လို့ မရပါ။ Token လက်ကျန် စစ်ပြီး ထပ်ကြိုးစားပါ။":
      "Could not deduct tokens. Please check your token balance and try again.",
    "AI ပုံ ထုတ်လို့ မရသေးပါ။": "Could not generate an AI image yet.",
    "AI ပုံ ထုတ်လို့ မရသေးပါ။ ထပ်ကြိုးစားပါ။": "Could not generate an AI image yet. Please try again.",
    "ပုံ ၃ ပုံအထိ၊ တစ်ပုံ ၅MB အောက်ပဲ ထည့်ပါ။": "At most 3 images, each under 5MB.",
    "Cloudflare free model က reference ပုံကို ပြင်လို့ မရဘူး — ပုံကို ဖြုတ်ပြီး စာနဲ့ပဲ ထုတ်ပါ၊ ဒါမှမဟုတ် Gemini (paid) ကို သုံးပါ။":
      "The Cloudflare free model cannot edit a reference image — remove the image and generate with text only, or use Gemini (paid).",
    "Cloudflare က ပုံ ပြန်မလာပါ။ ထပ်ကြိုးစားပါ။": "Cloudflare did not return an image. Please try again.",
    "AI ပုံ ပြန်မလာပါ။ ထပ်ကြိုးစားပါ။": "No AI image was returned. Please try again.",
  };
  if (map[msg]) return map[msg];
  const tokenMatch = /^Token မလောက်ပါ။ ဒီပုံက (\d+) token ကုန်မယ်၊ ကျန်တာ (.+) ပဲ ရှိတယ်။$/.exec(msg);
  if (tokenMatch) {
    return `Not enough tokens. This image costs ${tokenMatch[1]} tokens, you only have ${tokenMatch[2]}.`;
  }
  return msg;
}
