"use client";

import { useEffect, useState } from "react";
import { useLanguage } from "@/components/LanguageProvider";

/* Light / dark toggle. The choice is saved in localStorage
   ("thukha-theme") and applied as a `dark` class on <html>, so it
   survives reloads. First visit with no saved choice follows the
   device's prefers-color-scheme setting (and the no-flash script
   in layout.tsx applies it before first paint). */
export default function ThemeToggle() {
  const { t } = useLanguage();
  const [theme, setTheme] = useState<"light" | "dark" | null>(null);

  useEffect(() => {
    const saved = localStorage.getItem("thukha-theme");
    const dark =
      saved === "dark" ||
      (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
    // One-time initial sync from localStorage/device into the
    // button label, not a render loop.
    // eslint-disable-next-line react-hooks/set-state-in-effect
    setTheme(dark ? "dark" : "light");
  }, []);

  function toggle() {
    const next = theme === "dark" ? "light" : "dark";
    document.documentElement.classList.toggle("dark", next === "dark");
    localStorage.setItem("thukha-theme", next);
    setTheme(next);
  }

  return (
    <button
      type="button"
      onClick={toggle}
      aria-label={theme === "dark" ? t("theme.toLight") : t("theme.toDark")}
      className="flex min-h-[40px] shrink-0 items-center whitespace-nowrap rounded-full border border-thukha-lilac/40 bg-white/50 px-3 py-1.5 text-xs font-bold text-thukha-violet backdrop-blur-sm transition-all duration-200 hover:border-thukha-violet hover:bg-thukha-violet/10 hover:shadow-[0_0_12px_rgba(89,70,237,0.25)] hover:scale-105 active:scale-95 sm:px-4 sm:text-sm dark:border-white/15 dark:bg-white/5 dark:text-thukha-lilac dark:hover:border-thukha-lilac dark:hover:bg-white/10"
    >
      {theme === "dark" ? t("theme.light") : t("theme.dark")}
    </button>
  );
}
</file>

<file path="src/lib/tokens.ts">
/* ThuKha tokens — the customer's own credit, not the Gemini API key.
   The Gemini key stays server-only in .env.local and the customer
   never sees it. The customer starts with 100 ThuKha tokens, and
   each successful image costs an amount based on its difficulty:

     base                            10 tokens
     + 5 per reference image         (max +15, up to 3 images)
     + 5 for a large format          (Story / Cover)
     + 5 for a detailed prompt       (over 120 characters)

   So a simple post costs 10, the hardest (story/cover + 3 refs +
   long prompt) costs 35. Failed generations cost nothing — the
   client deducts only after the API returns an image.

   Prototype note: the balance lives in the browser's localStorage
   (key "thukha-tokens"), so it is per device/browser and can be
   reset by clearing site data. The real version needs Supabase
   auth + a server-side balance so a customer cannot reset it.

   Guests are different from customers: a guest (no login) starts
   with only GUEST_START_TOKENS (50) in this browser, while a
   logged-in customer starts with START_TOKENS (100) on the server.
   The server code must never use GUEST_START_TOKENS. */

export const START_TOKENS = 100;
export const GUEST_START_TOKENS = 50;
/* Guests may generate only GUEST_MAX_GENERATIONS images in this
   browser (localStorage key "thukha-guest-generations", counted
   only on a successful image, never on failure). Honest limit:
   this is browser-only, so clearing site data or switching
   browser/device resets it — it stops casual repeated use, it
   does not stop a determined person. Only login (server tokens)
   gives a real per-account limit. */
export const GUEST_MAX_GENERATIONS = 1;

export function tokenCost(input: {
  prompt: string;
  format: string;
  referenceCount: number;
}): number {
  let cost = 10;
  cost += Math.min(input.referenceCount, 3) * 5;
  if (input.format === "story" || input.format === "cover") cost += 5;
  if (input.prompt.trim().length > 120) cost += 5;
  return cost;
}
</file>

<file path="src/app/api/admin/stats/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";

/* Admin-only stats. The caller must be logged in AND have
   profiles.role = 'admin' (set by the owner in Supabase SQL, never
   by signup). Returns counts and the latest generations (with
   owner_id, so the dashboard can say WHO generated each one),
   plus the user list (id, display name, role) and token balances,
   and a per-customer breakdown: for every user, how many images
   they generated and how many tokens they spent in total. The
   breakdown is computed from ALL generations, not just the latest
   20 shown below — otherwise a heavy user past the 20-row list
   would look like they spent almost nothing. */
export async function GET(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ကြည့်လို့ရမယ်။" }, { status: 401 });
  }
  const { data: profile } = await service
    .from("profiles")
    .select("role")
    .eq("id", user.id)
    .single();
  if (profile?.role !== "admin") {
    return NextResponse.json({ error: "Admin မဟုတ်လို့ ကြည့်လို့ မရပါ။" }, { status: 403 });
  }
  // Counts must come from count queries, NOT from the limited lists
  // below (the old code reported users=50 / generations=20 as soon
  // as the lists hit their limits — a wrong admin dashboard).
  const [profiles, balances, generations, brands, designs, usersCount, generationsCount, allGenerations] = await Promise.all([
    service.from("profiles").select("id, display_name, role, suspended, created_at").order("created_at", { ascending: false }).limit(50),
    service.from("token_balances").select("owner_id, balance"),
    service.from("generations").select("id, owner_id, prompt, model, format, cost_tokens, flagged, created_at").order("created_at", { ascending: false }).limit(20),
    service.from("brands").select("id", { count: "exact", head: true }),
    service.from("designs").select("id", { count: "exact", head: true }),
    service.from("profiles").select("id", { count: "exact", head: true }),
    service.from("generations").select("id", { count: "exact", head: true }),
    // Only owner + cost are needed for the totals (Supabase caps a
    // plain select at 1000 rows — fine for this prototype's scale;
    // a bigger launch needs a real SQL aggregate instead).
    service.from("generations").select("owner_id, cost_tokens"),
  ]);
  const balanceOf = (ownerId: string) =>
    balances.data?.find((b) => b.owner_id === ownerId)?.balance ?? null;
  // Per-customer totals: every profile, even one with 0 generations,
  // so the admin sees who has NOT generated anything either.
  // Sorted by tokens spent, heaviest first.
  const totals = new Map<string, { generations: number; spent: number }>();
  for (const g of allGenerations.data ?? []) {
    if (!g.owner_id) continue;
    const cur = totals.get(g.owner_id) ?? { generations: 0, spent: 0 };
    cur.generations += 1;
    cur.spent += g.cost_tokens ?? 0;
    totals.set(g.owner_id, cur);
  }
  const perUser = (profiles.data ?? []).map((u) => ({
    id: u.id,
    display_name: u.display_name,
    role: u.role,
    balance: balanceOf(u.id),
    generations: totals.get(u.id)?.generations ?? 0,
    spent: totals.get(u.id)?.spent ?? 0,
  })).sort((a, b) => b.spent - a.spent || b.generations - a.generations);
  return NextResponse.json({
    users: profiles.data ?? [],
    balances: balances.data ?? [],
    generations: generations.data ?? [],
    perUser,
    counts: {
      users: usersCount.count ?? 0,
      brands: brands.count ?? 0,
      designs: designs.count ?? 0,
      generations: generationsCount.count ?? 0,
    },
  });
}
</file>

<file path="src/app/api/admin/tokens/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { logAudit } from "@/lib/audit";
import { notifyUser } from "@/lib/notify";

/* Prototype admin token refill: an admin adds tokens to any user's
   server balance. Admin-only (profiles.role = 'admin', checked
   server-side). Amount must be a whole number from 1 to 10000.
   If the user has no balance row yet, it is created with the
   refill amount (a first-time user normally gets 100 on first
   /api/tokens call, so this path is rare). The refill is logged
   in usage_events so it is auditable. This is a prototype free
   refill — before a real launch it must be replaced by a paid
   top-up (payment + admin approval), not a free button. */
export async function POST(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ လုပ်လို့ရမယ်။" }, { status: 401 });
  }
  const { data: profile } = await service
    .from("profiles")
    .select("role")
    .eq("id", user.id)
    .single();
  if (profile?.role !== "admin") {
    return NextResponse.json({ error: "Admin မဟုတ်လို့ လုပ်လို့ မရပါ။" }, { status: 403 });
  }
  const body = (await request.json()) as { userId?: string; amount?: number };
  const userId = (body.userId ?? "").trim();
  const amount = Math.floor(Number(body.amount));
  if (!userId) {
    return NextResponse.json({ error: "User id မရှိပါ။" }, { status: 400 });
  }
  if (!Number.isFinite(amount) || amount < 1 || amount > 10000) {
    return NextResponse.json({ error: "Amount က 1 ကနေ 10000 အတွင်း ဖြစ်ရမယ်။" }, { status: 400 });
  }
  // Admins must not refill themselves — a refill is for customers
  // only, otherwise an admin can enrich their own wallet for free.
  if (userId === user.id) {
    return NextResponse.json({ error: "ကိုယ့်ကိုယ်ကို token ဖြည့်လို့ မရပါ။ Customer တွေကိုပဲ ဖြည့်ပေးပါ။" }, { status: 400 });
  }
  // The target must be a real user — the old code returned success
  // even when the balance write failed (e.g. unknown user id, whose
  // token_balances insert violates the profiles FK).
  const { data: target } = await service
    .from("profiles")
    .select("id")
    .eq("id", userId)
    .single();
  if (!target) {
    return NextResponse.json({ error: "ဒီ user ကို မတွေ့ပါ။" }, { status: 404 });
  }
  const { data: existing } = await service
    .from("token_balances")
    .select("balance")
    .eq("owner_id", userId)
    .single();
  const nextBalance = (existing?.balance ?? 0) + amount;
  const writeError = existing
    ? (
        await service
          .from("token_balances")
          .update({ balance: nextBalance, updated_at: new Date().toISOString() })
          .eq("owner_id", userId)
      ).error
    : (
        await service
          .from("token_balances")
          .insert({ owner_id: userId, balance: nextBalance })
      ).error;
  if (writeError) {
    return NextResponse.json({ error: "Token ဖြည့်လို့ မရပါ။ ထပ်ကြိုးစားပါ။" }, { status: 502 });
  }
  // Audit log is best-effort: a log failure must not report a
  // successful refill as failed, but it also must not hide a
  // balance-write failure (checked above).
  await service.from("usage_events").insert({
    owner_id: userId,
    event: "admin_token_refill",
    cost_tokens: amount,
  });
  await logAudit(service, user.id, "admin_token_refill", userId, String(amount));
  await notifyUser(service, userId, "token_refill", String(amount), "/account");
  return NextResponse.json({ ok: true, balance: nextBalance });
}
</file>

<file path="src/app/api/support/route.ts">
import { NextResponse } from "next/server";
import { getServiceSupabase, getUserFromToken } from "@/lib/supabase/server";
import { notifyAdmins } from "@/lib/notify";

/* Customer support tickets (own only).
   GET: my tickets, newest first, with the admin reply when present.
   POST: open a new ticket. Login required — a ticket needs an
   owner, so guests cannot open one (they can still read the FAQ
   on /support without logging in). No email is sent; the customer
   sees the admin reply on /support. */
const CATEGORIES = ["token", "image", "download", "account", "payment", "other"] as const;

export async function GET(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ကြည့်လို့ရမယ်။" }, { status: 401 });
  }
  const { data, error } = await service
    .from("support_tickets")
    .select("id, category, subject, message, status, admin_reply, created_at, updated_at")
    .eq("owner_id", user.id)
    .order("created_at", { ascending: false })
    .limit(100);
  if (error) return NextResponse.json({ error: "Ticket ဖတ်လို့ မရပါ။" }, { status: 502 });
  return NextResponse.json({ tickets: data ?? [] });
}

export async function POST(request: Request) {
  const token = request.headers.get("authorization")?.replace("Bearer ", "");
  const user = await getUserFromToken(token);
  const service = getServiceSupabase();
  if (!user || !service) {
    return NextResponse.json({ error: "Login လုပ်ပြီးမှ ပို့လို့ရမယ်။" }, { status: 401 });
  }
  const body = (await request.json().catch(() => ({}))) as {
    category?: string;
    subject?: string;
    message?: string;
  };
  const category = (body.category ?? "").trim();
  const subject = (body.subject ?? "").trim();
  const message = (body.message ?? "").trim();
  if (!CATEGORIES.includes(category as (typeof CATEGORIES)[number])) {
    return NextResponse.json({ error: "အမျိုးအစား ရွေးပေးပါ။" }, { status: 400 });
  }
  if (!subject || subject.length > 200) {
    return NextResponse.json({ error: "ခေါင်းစဉ် ရေးပေးပါ (စာလုံး 200 ထက် မကျော်ရပါ)။" }, { status: 400 });
  }
  if (!message || message.length > 2000) {
    return NextResponse.json({ error: "အကူအညီလိုတဲ့ အကြောင်း ရေးပေးပါ (စာလုံး 2000 ထက် မကျော်ရပါ)။" }, { status: 400 });
  }
  const { data, error } = await service
    .from("support_tickets")
    .insert({ owner_id: user.id, category, subject, message, status: "open" })
    .select("id")
    .single();
  if (error || !data) return NextResponse.json({ error: "Ticket ပို့၍ မရပါ။" }, { status: 502 });
  await notifyAdmins(service, "support_new", subject, "/admin/support");
  return NextResponse.json({ id: data.id });
}
</file>

<file path="src/app/globals.css">
@import "tailwindcss";

/* Dark mode: Tailwind v4 custom variant responding to `dark` class on <html> */
@custom-variant dark (&:where(.dark, .dark *));

/* ThuKha Platform — Brand Colors + Vibrant Professional Accents */
@theme {
  --color-thukha-indigo: #10113d;
  --color-thukha-violet: #5946ed;
  --color-thukha-lilac: #a78bfa;
  --color-thukha-blue: #2f80ed;
  --color-thukha-teal: #22c7a9;
  --color-thukha-mist: #f6f7fb;
  --color-thukha-fuchsia: #d946ef;
  --color-thukha-amber: #f59e0b;
  --color-thukha-rose: #f43f5e;
  --font-sans: var(--font-inter), var(--font-myanmar), "Noto Sans Myanmar",
    "Pyidaungsu", system-ui, sans-serif;
}

:root {
  --background: #ffffff;
  --foreground: #10113d;
}

.dark {
  --background: #10113d;
  --foreground: #f6f7fb;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans);
  line-height: 1.6;
  overflow-x: hidden;
}

/* ========================================================
   KEYFRAME ANIMATIONS: Colorful, Fluid & Professional
   ======================================================== */

@keyframes thu-fade-up {
  from {
    opacity: 0;
    transform: translateY(18px) scale(0.995);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes thu-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes thu-scale-in {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes thu-gradient-flow {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

@keyframes thu-float {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-8px);
  }
}

@keyframes thu-float-delayed {
  0%, 100% {
    transform: translateY(0px) rotate(0deg);
  }
  50% {
    transform: translateY(-10px) rotate(1.5deg);
  }
}

@keyframes thu-aurora-spin {
  0% {
    transform: rotate(0deg) scale(1);
  }
  50% {
    transform: rotate(180deg) scale(1.12);
  }
  100% {
    transform: rotate(360deg) scale(1);
  }
}

@keyframes thu-pulse-glow {
  0%, 100% {
    box-shadow: 0 0 14px -2px rgba(89, 70, 237, 0.4), 0 0 6px -1px rgba(34, 199, 169, 0.25);
  }
  50% {
    box-shadow: 0 0 28px 4px rgba(89, 70, 237, 0.65), 0 0 16px 2px rgba(167, 139, 250, 0.45);
  }
}

@keyframes thu-ping-soft {
  0% {
    transform: scale(0.95);
    opacity: 0.8;
  }
  75%, 100% {
    transform: scale(2.2);
    opacity: 0;
  }
}

@keyframes thu-shimmer {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(200%);
  }
}

/* ========================================================
   GLOBAL ELEMENT STYLES & INTERACTION TRANSITIONS
   ======================================================== */

main {
  animation: thu-fade-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.anim-fade-in {
  animation: thu-fade-in 0.35s ease-out both;
}

.anim-scale-in {
  animation: thu-scale-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.anim-float {
  animation: thu-float 4s ease-in-out infinite;
}

.animate-thu-aurora-spin {
  animation: thu-aurora-spin 30s linear infinite;
}

.animate-thu-float {
  animation: thu-float 12s ease-in-out infinite;
}

.animate-thu-float-delayed {
  animation: thu-float-delayed 16s ease-in-out infinite;
}

/* Interactive elements */
button, a.btn-interactive {
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1),
              background 0.2s ease,
              border-color 0.2s ease,
              filter 0.2s ease;
}

button:hover:not(:disabled), a.btn-interactive:hover {
  transform: translateY(-2px);
}

button:active:not(:disabled), a.btn-interactive:active {
  transform: scale(0.97);
}

/* Card lift and smooth hover states */
.interactive-card {
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.25s ease;
}

.interactive-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px -8px rgba(89, 70, 237, 0.18),
              0 4px 16px -2px rgba(34, 199, 169, 0.14);
}

/* ========================================================
   COLORFUL SAAS UTILITY CLASSES
   ======================================================== */

/* Multi-stop colorful text gradient with fluid animation */
.colorful-text-gradient {
  background: linear-gradient(135deg, #5946ed 0%, #9333ea 25%, #ec4899 50%, #22c7a9 75%, #2f80ed 100%);
  background-size: 250% 250%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: thu-gradient-flow 7s ease infinite;
}

/* Violet to Teal energetic gradient text */
.colorful-brand-gradient {
  background: linear-gradient(120deg, #5946ed 0%, #a78bfa 40%, #22c7a9 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: thu-gradient-flow 6s ease infinite;
}

/* Colorful glowing button with sheen */
.colorful-btn-gradient {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #5946ed 0%, #7c3aed 45%, #2f80ed 100%);
  background-size: 200% 200%;
  color: #ffffff !important;
  box-shadow: 0 4px 16px -2px rgba(89, 70, 237, 0.45);
  animation: thu-gradient-flow 8s ease infinite;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.colorful-btn-gradient:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 26px 0 rgba(89, 70, 237, 0.6), 0 0 16px 0 rgba(34, 199, 169, 0.4);
}

/* Shimmer shine effect across cards and buttons on hover */
.shimmer-hover {
  position: relative;
  overflow: hidden;
}

.shimmer-hover::before {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 80%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.25) 50%,
    transparent 100%
  );
  transform: skewX(-20deg);
  pointer-events: none;
  transition: left 0.75s ease;
}

.shimmer-hover:hover::before {
  left: 150%;
}

/* Pulsing radar dot for live status / badges */
.pulsing-dot {
  position: relative;
  display: inline-flex;
}

.pulsing-dot::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 9999px;
  background: inherit;
  animation: thu-ping-soft 2s cubic-bezier(0, 0, 0.2, 1) infinite;
}

/* Animated gradient border accent for top of cards */
.gradient-border-top {
  position: relative;
}

.gradient-border-top::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, #5946ed, #ec4899, #22c7a9, #5946ed);
  background-size: 300% 100%;
  animation: thu-gradient-flow 5s linear infinite;
  border-top-left-radius: inherit;
  border-top-right-radius: inherit;
}

/* Stagger entrance delays */
.stagger-1 { animation-delay: 60ms; }
.stagger-2 { animation-delay: 120ms; }
.stagger-3 { animation-delay: 180ms; }
.stagger-4 { animation-delay: 240ms; }
.stagger-5 { animation-delay: 300ms; }

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  main,
  .anim-fade-in,
  .anim-scale-in,
  .anim-float,
  .animate-thu-aurora-spin,
  .animate-thu-float,
  .animate-thu-float-delayed,
  .colorful-text-gradient,
  .colorful-brand-gradient,
  .colorful-btn-gradient,
  .gradient-border-top::before,
  button,
  .interactive-card,
  .pulsing-dot::after {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
